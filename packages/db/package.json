{
  "name": "@igs/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./health": {
      "types": "./src/health.ts",
      "default": "./src/health.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./ids": {
      "types": "./src/ids.ts",
      "default": "./src/ids.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./testing/global-setup": {
      "types": "./src/testing/global-setup.ts",
      "default": "./src/testing/global-setup.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@igs/config": "workspace:*",
    "drizzle-orm": "0.38.3",
    "postgres": "3.4.5",
    "server-only": "0.0.1",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@igs/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.1",
    "drizzle-kit": "0.30.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "zod": "4.6.5"
  }
}
