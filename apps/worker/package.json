{
  "name": "@igs/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=react-server src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "bootstrap-owner": "tsx --conditions=react-server src/bootstrap-owner.ts",
    "migrate": "tsx --conditions=react-server src/migrate.ts",
    "seed-catalog": "tsx --conditions=react-server src/seed-catalog.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@igs/config": "workspace:*",
    "@igs/db": "workspace:*",
    "@igs/kernel": "workspace:*",
    "@igs/module-audit": "workspace:*",
    "@igs/module-catalog": "workspace:*",
    "@igs/module-identity": "workspace:*",
    "@igs/observability": "workspace:*",
    "drizzle-orm": "0.38.3",
    "pg-boss": "10.1.6",
    "pino": "9.5.0",
    "postgres": "3.4.5",
    "uuidv7": "1.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@igs/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.1",
    "tsup": "8.5.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
