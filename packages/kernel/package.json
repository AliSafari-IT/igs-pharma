    "zod": "4.6.5"
  },
  "devDependencies": {
    "@igs/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.1",
    "pg-boss": "10.1.6",
    "postgres": "3.4.5",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
