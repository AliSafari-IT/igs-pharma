# IGS backup (S3-compatible object storage, DigitalOcean Spaces)
IGS_BACKUP_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
IGS_BACKUP_S3_REGION=fra1
IGS_BACKUP_S3_BUCKET=asafarim-platform
IGS_BACKUP_S3_ACCESS_KEY=<your DO_SPACES_ACCESS_KEY_ID>
IGS_BACKUP_S3_SECRET_KEY=<your DO_SPACES_SECRET_ACCESS_KEY>
# age public key (recipient), generated with: age-keygen -o ~/igs-backup.key
    IGS_BACKUP_AGE_RECIPIENT=age1…
