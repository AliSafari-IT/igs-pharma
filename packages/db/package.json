{
  "name": "@igs/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./health": {
      "types": "./src/health.ts",
      "default": "./src/health.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@igs/config": "workspace:*",
    "drizzle-orm": "0.38.3",
    "postgres": "3.4.5",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@igs/tsconfig": "workspace:*",
    "@types/node": "22.10.2",
    "drizzle-kit": "0.30.1",
    "typescript": "5.7.2"
  }
}
