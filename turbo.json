{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"],
      "passThroughEnv": ["DOCKER_HOST", "TESTCONTAINERS_*", "TEST_DATABASE_URL"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_MAX_CONNECTIONS",
        "AUTH_SECRET",
        "AUTH_URL",
        "NODE_ENV"
      ]
    },
    "db:generate": {
      "outputs": ["drizzle/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_MAX_CONNECTIONS",
        "AUTH_SECRET",
        "AUTH_URL",
        "NODE_ENV"
      ]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_MAX_CONNECTIONS",
        "AUTH_SECRET",
        "AUTH_URL",
        "NODE_ENV"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
